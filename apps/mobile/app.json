{
  "expo": {
    "name": "BiteClub",
    "slug": "bite-club",
    "version": "1.0.0",
    "description": "The social food ordering platform. Start group orders with friends, split costs, share posts, and earn daily rewards.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "biteclub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biteclub.app"
    },
    "android": {
      "package": "com.biteclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFEFE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFEFE7",
          "dark": {
            "backgroundColor": "#120A06"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4df7297-2298-45ee-89e7-c6575e7570c4"
      }
    }
  }
}
